# PostgreSQL ulanish manzili
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pos_saas?schema=public"

# JWT tokenlarni imzolash uchun maxfiy kalit (kamida 32 ta belgi, tasodifiy qiymat qo'ying)
AUTH_SECRET="o'zgartiring-bu-yerga-kamida-32-belgili-tasodifiy-maxfiy-kalit"

# Ilova ishlaydigan asosiy manzil
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Node muhiti
NODE_ENV="development"

# Email yuborish (SMTP) — "Parolni unutdim" funksiyasi uchun.
# Agar bo'sh qoldirilsa, parolni tiklash havolasi terminalga (konsolga)
# chiqariladi — development uchun email xizmatisiz sinab ko'rish mumkin.
# Gmail uchun: SMTP_HOST="smtp.gmail.com", SMTP_PORT=587, "App Password" ishlatiladi.
# Boshqa xizmatlar: Resend, SendGrid, Mailgun — barchasi SMTP interfeysini qo'llab-quvvatlaydi.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="DoConBoshqar <no-reply@doconboshqar.uz>"
